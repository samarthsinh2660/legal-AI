# No credentials are required for the recon phase — every probed source
# (India Code, the Vanga S3 buckets, the SC/HC official portals) is public.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legal-ai

# Local dev database — started via `docker compose up -d`. Dev-only
# defaults live in docker-compose.yml; override here for anything else.
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=legal_ai_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://legal_ai:legal_ai_dev@localhost:5433/legal_ai

NEO4J_USER=neo4j
NEO4J_PASSWORD=legal_ai_dev
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
NEO4J_URI=bolt://localhost:7688

# Auth. No default for the secret: an unset one refuses every authenticated
# request, which is the safe failure. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
LEGAL_AI_JWT_SECRET=
# How long an access token lives, in seconds. 86400 = 24h. Logout revokes
# by jti, so this is the window a *leaked* token works unnoticed.
LEGAL_AI_JWT_EXPIRES_IN=86400
